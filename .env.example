# Node process only. Copy to .env; never commit real secrets.
PORT=3000
BETTER_AUTH_URL=http://localhost:3000
# Generate locally: openssl rand -base64 32
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GAMEVERSE_DB_PATH=./data/gameverse.sqlite
GAMEVERSE_UPLOAD_DIR=./data/avatars
# Additional exact application origins for LAN Guest testing; not Google redirect URIs.
GAMEVERSE_TRUSTED_ORIGINS=
# Optional reachable phone origin for QR while the owner stays on localhost.
GAMEVERSE_JOIN_ORIGIN=
# Optional existing internal user ID. Never an email or client-editable role.
GAMEVERSE_BOOTSTRAP_ADMIN_USER_ID=

# Optional pooled Postgres URL for distributed Vercel runtime. Empty keeps SQLite.
GAMEVERSE_DATABASE_URL=
